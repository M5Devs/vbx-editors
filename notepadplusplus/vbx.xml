<NotepadPlus>
    <UserLang name="VBX" ext="vbx">
        <Settings>
            <Global caseIgnored="yes" />
            <TreatAsSymbol comment="no" commentLine="yes" />
            <Prefix words1="no" words2="no" words3="no" words4="no" />
        </Settings>
        <KeywordLists>
            <Keywords name="Folder+">If While Do For "Select Case" Sub Function</Keywords>
            <Keywords name="Folder-">"End If" Wend Loop Next "End Select" "End Sub" "End Function"</Keywords>
            <Keywords name="Operators">+ - * / % &amp; = &lt; &gt; &lt;= &gt;= &lt;&gt;</Keywords>
            <Keywords name="Words1">Dim Const Else ElseIf Case "Case Else" Return "Exit For" "Exit While" "Exit Do" Print MsgBox InputBox Len Left Right Mid UCase LCase InStr Trim Replace Str Val Abs Sqr Rnd File.Write File.Read</Keywords>
            <Keywords name="Words2"></Keywords>
            <Keywords name="Words3"></Keywords>
            <Keywords name="Words4"></Keywords>
            <Keywords name="Comment">1&apos; 2 3 4 0</Keywords>
            <Keywords name="Delim1">1&quot; 2&quot; 3 0</Keywords>
            <Keywords name="Delim2"></Keywords>
            <Keywords name="Delim3"></Keywords>
        </KeywordLists>
        <Styles>
            <WordsStyle name="DEFAULT" styleID="11" fgColor="000000" bgColor="FFFFFF" fontName="" fontStyle="0" />
            <WordsStyle name="FOLDEROPEN" styleID="12" fgColor="0000FF" bgColor="FFFFFF" fontName="" fontStyle="1" />
            <WordsStyle name="FOLDERCLOSE" styleID="13" fgColor="0000FF" bgColor="FFFFFF" fontName="" fontStyle="1" />
            <WordsStyle name="KEYWORD1" styleID="5" fgColor="0000FF" bgColor="FFFFFF" fontName="" fontStyle="1" />
            <WordsStyle name="KEYWORD2" styleID="6" fgColor="000000" bgColor="FFFFFF" fontName="" fontStyle="0" />
            <WordsStyle name="KEYWORD3" styleID="7" fgColor="000000" bgColor="FFFFFF" fontName="" fontStyle="0" />
            <WordsStyle name="KEYWORD4" styleID="8" fgColor="000000" bgColor="FFFFFF" fontName="" fontStyle="0" />
            <WordsStyle name="COMMENT" styleID="1" fgColor="008000" bgColor="FFFFFF" fontName="" fontStyle="2" />
            <WordsStyle name="COMMENT LINE" styleID="2" fgColor="008000" bgColor="FFFFFF" fontName="" fontStyle="2" />
            <WordsStyle name="STRING" styleID="3" fgColor="808080" bgColor="FFFFFF" fontName="" fontStyle="0" />
            <WordsStyle name="OPERATOR" styleID="10" fgColor="800080" bgColor="FFFFFF" fontName="" fontStyle="0" />
        </Styles>
    </UserLang>
</NotepadPlus>
